# ============================================================================
# DATABASE
# ============================================================================
DATABASE_URL="postgresql://user:password@host:port/database?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:port/database" # For migrations

# ============================================================================
# NEXTAUTH
# ============================================================================
# For local development
NEXTAUTH_URL="http://localhost:3000"
# For production (update to your subdomain)
# NEXTAUTH_URL="https://app.repostai.io"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# Cookie Settings (optional)
# NEXTAUTH_COOKIE_DOMAIN="" # Leave empty for default, or set to your domain for cross-subdomain auth

# ============================================================================
# LINKEDIN OAUTH
# ============================================================================
LINKEDIN_CLIENT_ID="your-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="your-linkedin-client-secret"

# ============================================================================
# SUPABASE
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="repost-ai-uploads"

# ============================================================================
# AI PROVIDERS
# ============================================================================
# OpenAI
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_MODEL="gpt-4-turbo-preview"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Anthropic (Claude)
ANTHROPIC_API_KEY="sk-ant-your-anthropic-api-key"
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# Default AI Provider (openai or anthropic)
DEFAULT_AI_PROVIDER="openai"

# ============================================================================
# ADMIN & SECURITY
# ============================================================================
# Admin API Key (for viral posts upload)
ADMIN_API_KEY="your-secure-admin-key-here"
# Super Admin Panel password (used for /admin login)
ADMIN_PASSWORD="your-secure-admin-panel-password"

# ============================================================================
# STRIPE
# ============================================================================
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your-stripe-publishable-key"
STRIPE_WEBHOOK_SECRET="whsec_your-webhook-secret"

# Stripe Price IDs
STRIPE_PRICE_ID_STARTER="price_starter_id"
STRIPE_PRICE_ID_PRO="price_pro_id"
STRIPE_PRICE_ID_ENTERPRISE="price_enterprise_id"

# Client-side Stripe Price IDs (for pricing page)
NEXT_PUBLIC_STRIPE_PRICE_ID_STARTER="price_starter_id"
NEXT_PUBLIC_STRIPE_PRICE_ID_PRO="price_pro_id"

# ============================================================================
# PAYPAL
# ============================================================================
PAYPAL_CLIENT_ID="your-paypal-client-id"
PAYPAL_CLIENT_SECRET="your-paypal-client-secret"
PAYPAL_MODE="sandbox" # sandbox or live
PAYPAL_WEBHOOK_ID="your-paypal-webhook-id"

# PayPal Plan IDs
PAYPAL_PLAN_ID_STARTER_MONTHLY="P-starter-monthly-plan-id"
PAYPAL_PLAN_ID_STARTER_ANNUAL="P-starter-annual-plan-id"
PAYPAL_PLAN_ID_PRO_MONTHLY="P-pro-monthly-plan-id"
PAYPAL_PLAN_ID_PRO_ANNUAL="P-pro-annual-plan-id"

# Client-side PayPal Plan IDs (for pricing page)
NEXT_PUBLIC_PAYPAL_PLAN_ID_STARTER_MONTHLY="P-starter-monthly-plan-id"
NEXT_PUBLIC_PAYPAL_PLAN_ID_PRO_MONTHLY="P-pro-monthly-plan-id"

# ============================================================================
# RATE LIMITING (Upstash Redis)
# ============================================================================
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-redis-token"

# ============================================================================
# CRON JOB AUTHENTICATION
# ============================================================================
CRON_SECRET="your-cron-secret-key-generate-with-openssl-rand-base64-32"

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
NODE_ENV="development"
# For local development
APP_URL="http://localhost:3000"
# For production (update to your subdomain)
# APP_URL="https://app.repostai.io"
LOG_LEVEL="info" # debug, info, warn, error

# ============================================================================
# RATE LIMITS
# ============================================================================
# Requests per window
RATE_LIMIT_REQUESTS="100"
RATE_LIMIT_WINDOW="60000" # milliseconds

# ============================================================================
# GOOGLE ANALYTICS
# ============================================================================
# GA4 Measurement ID (e.g. G-XXXXXXXXXX) — leave empty to disable
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# ============================================================================
# FEATURES FLAGS
# ============================================================================
ENABLE_ANALYTICS="true"
ENABLE_EMAIL_NOTIFICATIONS="false"
ENABLE_LINKEDIN_AUTO_PUBLISH="true"
